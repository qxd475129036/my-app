"use client";

import { Fragment, useMemo, useState } from "react";
import { Pagination } from "./Pagination";

export interface Column<T> {
  key: string;
  label: string;
  sortable?: boolean;
  render?: (row: T) => React.ReactNode;
  width?: string;
  align?: "left" | "center" | "right";
  wrapHeader?: boolean;
  wrapText?: boolean;
}

export interface DataTableProps<T> {
  columns: Column<T>[];
  data: T[];
  keyExtractor: (row: T) => string;
  selectable?: boolean;
  selectedIds?: Set<string>;
  onSelectionChange?: (ids: Set<string>) => void;
  onSort?: (key: string, direction: "asc" | "desc") => void;
  sortKey?: string;
  sortDirection?: "asc" | "desc";
  emptyMessage?: string;
  loading?: boolean;
  pageSize?: number;
  currentPage?: number;
  totalItems?: number;
  onPageChange?: (page: number) => void;
  onPageSizeChange?: (size: number) => void;
  pagination?: boolean;
  expandedContent?: (row: T) => React.ReactNode;
  rowNumber?: boolean;
  rowNumberOffset?: number;
  wrapHeaders?: boolean;
}

export function DataTable<T>({
  columns,
  data,
  keyExtractor,
  selectable = false,
  selectedIds,
  onSelectionChange,
  onSort,
  sortKey,
  sortDirection,
  emptyMessage = "データがありません",
  loading = false,
  pageSize,
  currentPage,
  totalItems,
  onPageChange,
  onPageSizeChange,
  pagination = true,
  expandedContent,
  rowNumber = true,
  rowNumberOffset,
  wrapHeaders = false,
}: DataTableProps<T>) {
  const [internalSortKey, setInternalSortKey] = useState<string>("");
  const [internalSortDir, setInternalSortDir] = useState<"asc" | "desc">("asc");
  const [expandedIds, setExpandedIds] = useState<Set<string>>(new Set());

  const activeSortKey = sortKey ?? internalSortKey;
  const activeSortDir = sortDirection ?? internalSortDir;
  const isControlled = !!onSort;

  const toggleSort = (key: string) => {
    if (isControlled) {
      const newDir =
        activeSortKey === key && activeSortDir === "asc" ? "desc" : "asc";
      onSort(key, newDir);
    } else {
      setInternalSortKey(key);
      setInternalSortDir(
        activeSortKey === key && internalSortDir === "asc" ? "desc" : "asc"
      );
    }
  };

  const toggleExpand = (id: string) => {
    setExpandedIds((prev) => {
      const next = new Set(prev);
      next.has(id) ? next.delete(id) : next.add(id);
      return next;
    });
  };

  // Internal sorting
  const sortedData = useMemo(() => {
    if (isControlled || !internalSortKey) return data;
    const sorted = [...data];
    sorted.sort((a, b) => {
      const aVal = (a as Record<string, unknown>)[internalSortKey];
      const bVal = (b as Record<string, unknown>)[internalSortKey];
      if (aVal == null && bVal == null) return 0;
      if (aVal == null) return 1;
      if (bVal == null) return -1;
      const cmp = String(aVal).localeCompare(String(bVal), "ja");
      return internalSortDir === "asc" ? cmp : -cmp;
    });
    return sorted;
  }, [data, internalSortKey, internalSortDir, isControlled]);


  const allSelected =
    selectable && sortedData.length > 0
      ? sortedData.every((row) => selectedIds?.has(keyExtractor(row)))
      : false;

  const toggleAll = () => {
    if (!onSelectionChange) return;
    if (allSelected) {
      onSelectionChange(new Set());
    } else {
      onSelectionChange(new Set(sortedData.map((row) => keyExtractor(row))));
    }
  };

  const toggleRow = (id: string) => {
    if (!onSelectionChange || !selectedIds) return;
    const next = new Set(selectedIds);
    if (next.has(id)) {
      next.delete(id);
    } else {
      next.add(id);
    }
    onSelectionChange(next);
  };

  // Calculate optimal column widths based on content length
  const columnStyles = useMemo(() => {
    if (data.length === 0) return columns.map(() => ({} as React.CSSProperties));

    return columns.map((col) => {
      // When an explicit width is provided, use it directly
      if (col.width) {
        return {
          width: col.width,
          minWidth: col.width,
          whiteSpace: (col.wrapText ? "normal" as const : "nowrap" as const),
          ...(col.wrapText ? { overflowWrap: "break-word" as const, wordBreak: "break-word" as const } : {}),
        };
      }

      let maxLength = col.label.length;

      if (!col.render) {
        for (const row of data) {
          const val = (row as Record<string, unknown>)[col.key];
          const text = val != null ? String(val) : "";
          if (text.length > maxLength) maxLength = text.length;
        }
      }

      if (col.wrapText) {
        return {
          whiteSpace: "normal" as const,
          overflowWrap: "break-word" as const,
          wordBreak: "break-word" as const,
          minWidth: `${Math.max(maxLength, 8)}ch`,
        };
      }

      const LONG_THRESHOLD = 40;
      if (maxLength > LONG_THRESHOLD) {
        return {
          maxWidth: `${Math.min(maxLength, 80)}ch`,
          whiteSpace: "normal" as const,
          wordBreak: "break-word" as const,
        };
      }

      return {
        whiteSpace: "nowrap" as const,
        minWidth: `${Math.max(maxLength, 8)}ch`,
      };
    });
  }, [columns, data]);

  const hasExpand = !!expandedContent;
  const hasRowNumber = !!rowNumber;

  const extraColCount =
    (hasRowNumber ? 1 : 0) + (hasExpand ? 1 : 0) + (selectable ? 1 : 0);

  const getRowNumber = (index: number): number => {
    if (rowNumberOffset != null) return rowNumberOffset + index;
    if (currentPage && pageSize) return (currentPage - 1) * pageSize + index + 1;
    return index + 1;
  };

  if (loading) {
    return (
      <div className="rounded-xl border border-border bg-white max-w-full">
        <div className="p-12 text-center">
          <div className="inline-block h-6 w-6 animate-spin rounded-full border-2 border-border border-t-accent" />
          <p className="mt-3 text-sm text-muted">読み込み中...</p>
        </div>
      </div>
    );
  }

  // Compute total min-width from explicit column widths
  const tableMinWidth = useMemo(() => {
    let total = 0;
    // Row number column ~4ch ≈ 32px at 8px font
    if (rowNumber) total += 32;
    if (hasExpand) total += 40;
    if (selectable) total += 40;
    for (const col of columns) {
      if (col.width) {
        const parsed = parseInt(col.width, 10);
        if (!isNaN(parsed)) total += parsed;
      }
    }
    return total;
  }, [columns, rowNumber, hasExpand, selectable]);

  // Only use explicit width when columns have defined widths
  const hasDefinedWidth = columns.some((col) => !!col.width);
  const tableWidth = hasDefinedWidth ? tableMinWidth : undefined;

  return (
    <div className="rounded-xl border border-border bg-white max-w-full">
      <div className="overflow-x-auto">
        <table className="text-sm" style={{ tableLayout: "fixed", width: tableWidth, minWidth: tableWidth }}>
          <colgroup>
            {hasRowNumber && <col style={{ width: "4ch" }} />}
            {hasExpand && <col style={{ width: "2.5rem" }} />}
            {selectable && <col style={{ width: "2.5rem" }} />}
            {columns.map((col, i) => <col key={col.key} style={columnStyles[i]} />)}
          </colgroup>
          <thead>
            <tr className="border-b border-border bg-gray-50/80">
              {hasRowNumber && (
                <th className="px-4 py-3 text-right text-xs font-semibold text-muted uppercase tracking-wider w-12">
                  #
                </th>
              )}
              {hasExpand && <th className="w-10 px-4 py-3 text-left" />}
              {selectable && (
                <th className="w-10 px-4 py-3 text-left">
                  <input
                    type="checkbox"
                    checked={allSelected}
                    onChange={toggleAll}
                    className="h-4 w-4 rounded border-border text-accent focus:ring-accent/20 cursor-pointer"
                  />
                </th>
              )}
              {columns.map((col) => {
                const isSorted = activeSortKey === col.key;
                const align = col.align || "left";
                const wrapHeader = col.wrapHeader ?? wrapHeaders;
                return (
                  <th
                    key={col.key}
                    style={{
                      width: col.width,
                      whiteSpace: wrapHeader ? "normal" : "nowrap",
                      ...(wrapHeader ? { wordBreak: "break-word" } : {}),
                    }}
                    className={`px-4 py-3 text-${align} text-xs font-semibold uppercase tracking-wider ${
                      isSorted ? "text-accent bg-accent-light" : "text-muted"
                    } ${
                      col.sortable ? "cursor-pointer select-none hover:text-foreground" : ""
                    } transition-colors`}
                    onClick={() => col.sortable && toggleSort(col.key)}
                  >
                    <span className={`inline-flex items-center gap-1.5 ${isSorted ? "font-bold" : ""}`}>
                      {col.label}
                      {col.sortable && (
                        <span className="inline-flex items-center ml-0.5">
                          {isSorted ? (
                            <svg
                              className="h-4 w-4 text-accent"
                              viewBox="0 0 16 16"
                              fill="currentColor"
                            >
                              {activeSortDir === "asc" ? (
                                <path d="M8 2l6 10H2z" />
                              ) : (
                                <path d="M8 14L2 4h12z" />
                              )}
                            </svg>
                          ) : (
                            <svg
                              className="h-3.5 w-3.5 text-gray-300"
                              viewBox="0 0 16 16"
                              fill="none"
                              stroke="currentColor"
                              strokeWidth={1.5}
                              strokeLinecap="round"
                              strokeLinejoin="round"
                            >
                              <path d="M5 10l3 3 3-3M5 6l3-3 3 3" />
                            </svg>
                          )}
                        </span>
                      )}
                    </span>
                  </th>
                );
              })}
            </tr>
          </thead>
          <tbody className="divide-y divide-border">
            {sortedData.length === 0 ? (
              <tr>
                <td
                  colSpan={columns.length + extraColCount}
                  className="px-4 py-12 text-center text-sm text-muted"
                >
                  {emptyMessage}
                </td>
              </tr>
            ) : (
              sortedData.map((row, index) => {
                const id = keyExtractor(row);
                const isSelected = selectedIds?.has(id);
                const isExpanded = expandedIds.has(id);
                return (
                  <Fragment key={id}>
                    <tr
                      className={`transition-colors ${
                        isSelected ? "bg-accent-light" : "even:bg-gray-50/50 hover:bg-blue-50/40"
                      }`}
                    >
                      {hasRowNumber && (
                        <td className="px-4 py-3 text-right text-xs text-muted font-mono tabular-nums w-12">
                          {getRowNumber(index)}
                        </td>
                      )}
                      {hasExpand && (
                        <td className="px-4 py-3 w-10">
                          <button
                            onClick={() => toggleExpand(id)}
                            className="p-0.5 rounded hover:bg-gray-200 transition-colors cursor-pointer"
                            aria-label={isExpanded ? "折りたたむ" : "展開する"}
                          >
                            <svg
                              className={`h-4 w-4 text-muted transition-transform ${
                                isExpanded ? "rotate-180" : ""
                              }`}
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              strokeWidth={2}
                            >
                              <path strokeLinecap="round" strokeLinejoin="round" d="M19 9l-7 7-7-7" />
                            </svg>
                          </button>
                        </td>
                      )}
                      {selectable && (
                        <td className="px-4 py-3">
                          <input
                            type="checkbox"
                            checked={!!isSelected}
                            onChange={() => toggleRow(id)}
                            className="h-4 w-4 rounded border-border text-accent focus:ring-accent/20 cursor-pointer"
                          />
                        </td>
                      )}
                      {columns.map((col) => {
                        const align = col.align || "left";
                        return (
                          <td
                            key={col.key}
                            style={columnStyles[columns.indexOf(col)]}
                            className={`px-4 py-3 text-${align} text-sm text-foreground`}
                          >
                            {col.render
                              ? col.render(row)
                              : ((row as Record<string, unknown>)[col.key] as React.ReactNode) ?? "-"}
                          </td>
                        );
                      })}
                    </tr>
                    {isExpanded && expandedContent && (
                      <tr className="border-t-0">
                        <td
                          colSpan={columns.length + extraColCount}
                          className="px-4 py-4 bg-gray-50/60 border-b border-border"
                        >
                          {expandedContent(row)}
                        </td>
                      </tr>
                    )}
                  </Fragment>
                );
              })
            )}
          </tbody>
        </table>
      </div>
      {pagination !== false && pageSize && currentPage && totalItems !== undefined && onPageChange && (
        <Pagination
          currentPage={currentPage}
          totalItems={totalItems}
          pageSize={pageSize}
          onPageChange={onPageChange}
          onPageSizeChange={onPageSizeChange}
        />
      )}
    </div>
  );
}
